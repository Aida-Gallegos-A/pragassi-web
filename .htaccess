# Pragassi · configuración para Hostinger (Apache / LiteSpeed)

# --- Siempre HTTPS y sin "www" ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# --- Tipos de archivo ---
<IfModule mod_mime.c>
  AddType model/gltf-binary .glb
  AddType image/webp .webp
  AddType application/wasm .wasm
  AddType application/manifest+json .webmanifest
</IfModule>

# --- Compresión (texto, JSON y modelos 3D) ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml model/gltf-binary application/wasm
</IfModule>

# --- Caché: los archivos con huella (assets/) duran un año; el HTML siempre se revisa ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType model/gltf-binary "access plus 1 month"
  ExpiresByType application/json "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|wasm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Seguridad básica
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# --- Páginas no encontradas vuelven al inicio ---
ErrorDocument 404 /index.html

# --- No listar carpetas ---
Options -Indexes
